---
interface Props {
  name: string;
  checked?: boolean;
  disabled?: boolean;
  id?: string;
}

const { name, checked = false, disabled = false, id, ...rest } = Astro.props;
---

<input
  type="checkbox"
  name={name}
  id={id}
  checked={checked}
  disabled={disabled}
  class="checkbox-primitive"
  {...rest}
/>

<style>
  .checkbox-primitive {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-sm);
    border: var(--border-width-hairline) solid var(--border);
    cursor: pointer;
    accent-color: var(--brand-primary);
  }
</style>
