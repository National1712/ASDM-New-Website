---
interface Props {
  gap?: '1' | '2' | '3' | '4' | '6' | '8' | '10';
  class?: string;
}

const { gap = '4', class: className = '' } = Astro.props;
---

<div class={`stack gap-${gap} ${className}`}>
  <slot />
</div>

<style>
  .stack {
    display: flex;
    flex-direction: column;
  }

  .gap-1 {
    gap: var(--sp-1);
  }
  .gap-2 {
    gap: var(--sp-2);
  }
  .gap-3 {
    gap: var(--sp-3);
  }
  .gap-4 {
    gap: var(--sp-4);
  }
  .gap-6 {
    gap: var(--sp-6);
  }
  .gap-8 {
    gap: var(--sp-8);
  }
  .gap-10 {
    gap: var(--sp-10);
  }
</style>
