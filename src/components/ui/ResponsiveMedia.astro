---
interface Props {
  src: string;
  alt: string;
  aspectRatio?: '1:1' | '16:9' | '4:3' | '3:2';
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  fetchPriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  aspectRatio = '16:9',
  width,
  height,
  loading = 'lazy',
  fetchPriority = 'auto',
  decoding = 'async',
  sizes,
  class: className = '',
} = Astro.props;
---

<div
  class={`media-wrapper aspect-${aspectRatio.replace(':', '-')} ${className}`}
>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchPriority}
    decoding={decoding}
    sizes={sizes}
    class="responsive-image"
  />
</div>

<style>
  .media-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--surface-soft);
    width: 100%;
  }

  .responsive-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Aspect Ratios */
  .aspect-1-1 {
    padding-bottom: 100%;
  }
  .aspect-16-9 {
    padding-bottom: 56.25%;
  }
  .aspect-4-3 {
    padding-bottom: 75%;
  }
  .aspect-3-2 {
    padding-bottom: 66.67%;
  }
</style>
