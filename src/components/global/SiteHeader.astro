---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
---

<header class="site-header" data-site-header>
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="ASDM home">
      <Logo />
    </a>

    <div class="nav-desktop-only">
      <DesktopNavigation />
    </div>

    <div class="cta-desktop-only" aria-label="Header actions">
      <Button href="/contact" variant="primary" size="md" class="header-cta"
        >Enquire Now</Button
      >
    </div>

    <div class="nav-mobile-only">
      <MobileNavigation />
    </div>
  </div>
</header>

<style>
  .site-header {
    min-height: 4.75rem;
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.94);
    border-bottom: var(--border-width-hairline) solid rgba(17, 24, 39, 0.08);
    backdrop-filter: blur(12px);
  }

  .header-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    min-height: 4.75rem;
    padding: 0 var(--sp-gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--sp-6);
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-self: start;
    border-radius: var(--radius-sm);
  }

  .nav-desktop-only {
    justify-self: start;
  }

  .cta-desktop-only {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
  }

  :global(.header-cta) {
    height: 2.625rem !important;
    padding-inline: var(--sp-5);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em !important;
  }

  .nav-mobile-only {
    display: none;
  }

  @media (max-width: 1100px) {
    .site-header {
      min-height: 4.0625rem;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      min-height: 4.0625rem;
    }

    .nav-desktop-only,
    .cta-desktop-only {
      display: none;
    }
    .nav-mobile-only {
      display: block;
    }
  }
</style>
