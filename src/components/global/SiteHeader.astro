---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
---

<header class="site-header" data-site-header>
  <div class="brand-accent" aria-hidden="true"></div>
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="ASDM home">
      <Logo />
    </a>

    <div class="nav-desktop-only">
      <DesktopNavigation />
    </div>

    <div class="cta-desktop-only" aria-label="Header actions">
      <a href="tel:+919327967701" class="header-utility">
        <svg class="phone-icon" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M6.4 2.8 8 6.4 6.7 7.7c.8 1.7 2.1 3.1 3.8 3.9l1.4-1.3 3.5 1.6-.6 3.1c-.2.8-.8 1.3-1.6 1.3C7.7 16.3 3.4 12 3.4 6.5c0-.8.5-1.4 1.3-1.6l1.7-.1Z"
          ></path>
        </svg>
        <span>93279 67701</span>
      </a>
      <span class="header-action-divider" aria-hidden="true"></span>
      <Button href="/contact" variant="primary" size="md" class="header-cta"
        >Book Free Counselling</Button
      >
    </div>

    <div class="nav-mobile-only">
      <MobileNavigation />
    </div>
  </div>
</header>

<style>
  .site-header {
    min-height: 4.875rem;
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.94);
    border-bottom: var(--border-width-hairline) solid rgba(17, 24, 39, 0.08);
    backdrop-filter: blur(12px);
  }

  .brand-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--brand-primary) 0%,
      var(--brand-accent) 58%,
      var(--brand-secondary) 100%
    );
  }

  .header-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    min-height: 4.875rem;
    padding: 0 var(--sp-gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--sp-6);
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-self: start;
    border-radius: var(--radius-sm);
  }

  .nav-desktop-only {
    justify-self: start;
  }

  .cta-desktop-only {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-4);
    justify-self: end;
  }

  .header-utility {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-secondary);
    font-size: 0.84375rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    transition:
      color var(--mot-fast) var(--ease-emphasis),
      opacity var(--mot-fast) var(--ease-emphasis);
  }

  .header-utility:hover,
  .header-utility:focus-visible {
    color: var(--text-primary);
  }

  .phone-icon {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: var(--brand-primary);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .header-action-divider {
    width: var(--border-width-hairline);
    height: 1.25rem;
    background-color: var(--border);
  }

  :global(.header-cta) {
    min-width: 11.25rem;
    height: 2.625rem;
    padding-inline: 1.375rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em !important;
  }

  .nav-mobile-only {
    display: none;
  }

  @media (max-width: 980px) {
    .site-header {
      min-height: 4.125rem;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      min-height: 4.125rem;
    }

    .nav-desktop-only,
    .cta-desktop-only {
      display: none;
    }
    .nav-mobile-only {
      display: block;
    }
  }
</style>
