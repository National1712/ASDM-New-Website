---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
---

<header class="site-header" data-site-header>
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="ASDM home">
      <Logo />
    </a>

    <div class="nav-desktop-only">
      <DesktopNavigation />
    </div>

    <div class="cta-desktop-only" aria-label="Header actions">
      <a href="tel:+919327967701" class="header-utility">
        <svg class="phone-icon" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M6.4 2.8 8 6.4 6.7 7.7c.8 1.7 2.1 3.1 3.8 3.9l1.4-1.3 3.5 1.6-.6 3.1c-.2.8-.8 1.3-1.6 1.3C7.7 16.3 3.4 12 3.4 6.5c0-.8.5-1.4 1.3-1.6l1.7-.1Z"
          ></path>
        </svg>
        <span>93279 67701</span>
      </a>
      <Button href="/contact" variant="primary" size="md" class="header-cta"
        >Book Free Counselling</Button
      >
    </div>

    <div class="nav-mobile-only">
      <MobileNavigation />
    </div>
  </div>
</header>

<style>
  .site-header {
    min-height: 4.5rem;
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.94);
    border-bottom: var(--border-width-hairline) solid rgba(17, 24, 39, 0.08);
    backdrop-filter: blur(12px);
  }

  .header-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    min-height: 4.5rem;
    padding: 0 var(--sp-gutter);
    display: grid;
    grid-template-columns: auto minmax(0, auto) auto;
    align-items: center;
    justify-content: space-between;
    column-gap: clamp(var(--sp-8), 4vw, var(--sp-16));
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-self: start;
    border-radius: var(--radius-sm);
  }

  .nav-desktop-only {
    justify-self: center;
  }

  .cta-desktop-only {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-3);
    justify-self: end;
  }

  .header-utility {
    min-height: 2.625rem;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    transition:
      color var(--mot-fast) var(--ease-emphasis),
      opacity var(--mot-fast) var(--ease-emphasis);
  }

  .header-utility:hover,
  .header-utility:focus-visible {
    color: var(--text-primary);
  }

  .phone-icon {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--brand-primary);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(.header-cta) {
    min-width: 10.875rem;
    height: 2.75rem;
    padding-inline: var(--sp-5);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em !important;
  }

  .nav-mobile-only {
    display: none;
  }

  @media (max-width: 1040px) {
    .site-header {
      min-height: 4.25rem;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      min-height: 4.25rem;
    }

    .nav-desktop-only,
    .cta-desktop-only {
      display: none;
    }
    .nav-mobile-only {
      display: block;
    }
  }
</style>
