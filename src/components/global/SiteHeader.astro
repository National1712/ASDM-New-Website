---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';
---

<header class="site-header" data-site-header>
  <div class="header-container">
    <a href="/" class="logo-link" aria-label="ASDM home">
      <Logo />
    </a>

    <div class="nav-desktop-only">
      <DesktopNavigation />
    </div>

    <div class="cta-desktop-only" aria-label="Header actions">
      <a href="tel:+919327967701" class="header-utility">Call 9327967701</a>
      <Button href="/contact" variant="primary" size="sm" class="header-cta"
        >Book Free Counselling</Button
      >
    </div>

    <div class="nav-mobile-only">
      <MobileNavigation />
    </div>
  </div>
</header>

<style>
  .site-header {
    min-height: var(--header-height);
    position: sticky;
    top: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.92);
    border-bottom: var(--border-width-hairline) solid rgba(199, 206, 216, 0.72);
    backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(17, 19, 26, 0.02);
  }

  .header-container {
    width: 100%;
    max-width: var(--container-wide);
    margin: 0 auto;
    min-height: var(--header-height);
    padding: var(--sp-2) var(--sp-gutter);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(var(--sp-4), 3vw, var(--sp-10));
  }

  .logo-link {
    display: flex;
    align-items: center;
    justify-self: start;
    border-radius: var(--radius-sm);
    padding: var(--sp-1) 0;
  }

  .nav-desktop-only {
    justify-self: center;
  }

  .cta-desktop-only {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-4);
    justify-self: end;
  }

  .header-utility {
    min-height: 2.5rem;
    display: inline-flex;
    align-items: center;
    color: var(--text-secondary);
    font-size: var(--fs-nav);
    font-weight: var(--fw-medium);
    transition: color var(--mot-fast) var(--ease-emphasis);
  }

  .header-utility:hover,
  .header-utility:focus-visible {
    color: var(--brand-primary);
  }

  :global(.header-cta) {
    min-width: 11.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
  }

  .nav-mobile-only {
    display: none;
  }

  @media (max-width: 1040px) {
    .site-header {
      min-height: 4.25rem;
    }

    .header-container {
      display: flex;
      justify-content: space-between;
      min-height: 4.25rem;
      padding-top: var(--sp-2);
      padding-bottom: var(--sp-2);
    }

    .nav-desktop-only,
    .cta-desktop-only {
      display: none;
    }
    .nav-mobile-only {
      display: block;
    }
  }
</style>
