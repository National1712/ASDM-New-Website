---
import { courseNavigation, mainNavigation } from '../../data/navigation';
---

<div class="mobile-nav-wrapper">
  <button
    class="mobile-menu-trigger"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Open navigation menu"
  >
    <span class="hamburger-box">
      <span class="hamburger-inner"></span>
    </span>
  </button>

  <div
    id="mobile-menu"
    class="mobile-menu-drawer sr-only"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation menu"
  >
    <nav class="mobile-nav" aria-label="Primary navigation">
      <ul class="mobile-nav-list">
        {
          mainNavigation.map((item) => (
            <li class="mobile-nav-item">
              <a href={item.href} class="mobile-nav-link">
                <span>{item.label}</span>
                {item.label === 'Digital Marketing Courses' && (
                  <svg
                    class="mobile-chevron"
                    viewBox="0 0 16 16"
                    aria-hidden="true"
                  >
                    <path d="m4 6 4 4 4-4" />
                  </svg>
                )}
              </a>
              {item.label === 'Digital Marketing Courses' && (
                <ul class="mobile-course-list" aria-label="Course links">
                  {[
                    ...courseNavigation.programmes,
                    ...courseNavigation.locations,
                  ].map((course) => (
                    <li>
                      <a href={course.href} class="mobile-course-link">
                        {course.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-actions" aria-label="Mobile header actions">
      <a href="/contact" class="mobile-action mobile-action-primary">
        <span>Enquire Now</span>
        <svg class="mobile-action-icon" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M6 14 14 6M8 6h6v6"></path>
        </svg>
      </a>
      <a href="tel:+919327967701" class="mobile-action mobile-action-secondary">
        <svg class="mobile-action-icon" viewBox="0 0 20 20" aria-hidden="true">
          <path
            d="M6.4 2.8 8 6.4 6.7 7.7c.8 1.7 2.1 3.1 3.8 3.9l1.4-1.3 3.5 1.6-.6 3.1c-.2.8-.8 1.3-1.6 1.3C7.7 16.3 3.4 12 3.4 6.5c0-.8.5-1.4 1.3-1.6l1.7-.1Z"
          ></path>
        </svg>
        <span>93279 67701</span>
      </a>
      <a
        href="https://wa.me/919327967701?text=Inquiry%20for%20digital%20marketing%20course"
        class="mobile-action mobile-action-secondary">WhatsApp</a
      >
    </div>
  </div>
</div>

<script>
  const trigger = document.querySelector(
    '.mobile-menu-trigger'
  ) as HTMLButtonElement;
  const drawer = document.querySelector(
    '.mobile-menu-drawer'
  ) as HTMLDivElement;

  if (trigger && drawer) {
    const focusableSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    const closeMenu = () => {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.setAttribute('aria-label', 'Open navigation menu');
      trigger.classList.remove('menu-active');
      drawer.classList.add('sr-only');
      document.body.classList.remove('menu-open');
    };

    const openMenu = () => {
      trigger.setAttribute('aria-expanded', 'true');
      trigger.setAttribute('aria-label', 'Close navigation menu');
      trigger.classList.add('menu-active');
      drawer.classList.remove('sr-only');
      document.body.classList.add('menu-open');
      const firstFocusable = drawer.querySelector(
        focusableSelector
      ) as HTMLElement | null;
      firstFocusable?.focus();
    };

    trigger.addEventListener('click', () => {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      if (expanded) closeMenu();
      else openMenu();
    });

    window.addEventListener('keydown', (e) => {
      if (
        e.key === 'Escape' &&
        trigger.getAttribute('aria-expanded') === 'true'
      ) {
        closeMenu();
        trigger.focus();
      }
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }
</script>

<style>
  .mobile-nav-wrapper {
    position: relative;
  }

  .mobile-menu-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: var(--border-width-hairline) solid var(--border);
    border-radius: var(--radius-md);
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    z-index: 100;
    transition:
      background-color var(--mot-fast) var(--ease-emphasis),
      border-color var(--mot-fast) var(--ease-emphasis),
      color var(--mot-fast) var(--ease-emphasis);
  }

  .mobile-menu-trigger:hover,
  .mobile-menu-trigger:focus-visible,
  .mobile-menu-trigger.menu-active {
    background-color: var(--brand-primary-soft);
    border-color: var(--brand-primary-subtle);
    color: var(--brand-primary);
  }

  .hamburger-box {
    position: relative;
    width: 1.5rem;
    height: 1.25rem;
  }

  .hamburger-inner,
  .hamburger-inner::before,
  .hamburger-inner::after {
    position: absolute;
    width: 1.5rem;
    height: 2px;
    background-color: currentColor;
    transition: transform var(--mot-fast) var(--ease-emphasis);
  }

  .hamburger-inner {
    top: 50%;
    transform: translateY(-50%);
  }

  .hamburger-inner::before {
    content: '';
    top: -6px;
  }

  .hamburger-inner::after {
    content: '';
    bottom: -6px;
  }

  .menu-active .hamburger-inner {
    transform: rotate(45deg);
  }

  .menu-active .hamburger-inner::before {
    transform: translateY(6px) rotate(-90deg);
  }

  .menu-active .hamburger-inner::after {
    transform: translateY(-6px) rotate(-90deg);
  }

  .mobile-menu-drawer {
    position: fixed;
    inset: 4.125rem 0 0 0;
    width: 100vw;
    min-height: calc(100dvh - 4.125rem);
    background-color: var(--canvas);
    z-index: 120;
    padding: var(--sp-6) var(--sp-gutter) var(--sp-8);
    overflow-y: auto;
    border-top: var(--border-width-hairline) solid var(--border);
    box-shadow: 0 1.5rem 3rem rgba(17, 19, 26, 0.1);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .mobile-nav-link {
    display: flex;
    min-height: var(--touch-target);
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    border-bottom: var(--border-width-hairline) solid var(--border);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    transition:
      color var(--mot-fast) var(--ease-emphasis),
      border-color var(--mot-fast) var(--ease-emphasis);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    outline: 0;
    color: var(--brand-primary);
  }

  .mobile-chevron {
    width: 0.875rem;
    height: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-course-list {
    display: grid;
    gap: var(--sp-1);
    list-style: none;
    margin: var(--sp-3) 0 var(--sp-4);
    padding: 0 0 0 var(--sp-4);
    border-left: var(--border-width-standard) solid var(--brand-primary-subtle);
  }

  .mobile-course-link {
    display: flex;
    min-height: 2.25rem;
    align-items: center;
    font-size: var(--fs-body-sm);
    font-weight: 500;
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  .mobile-course-link:hover,
  .mobile-course-link:focus-visible {
    outline: 0;
    color: var(--brand-primary);
  }

  .mobile-actions {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .mobile-action {
    display: inline-flex;
    min-height: var(--touch-target);
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .mobile-action-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-action-primary {
    background-color: var(--brand-primary);
    color: #ffffff;
    transition: background-color var(--mot-fast) var(--ease-emphasis);
  }

  .mobile-action-primary:hover,
  .mobile-action-primary:focus-visible {
    background-color: var(--brand-primary-hover);
  }

  .mobile-action-secondary {
    background-color: var(--surface);
    border: var(--border-width-hairline) solid var(--border);
    color: var(--text-primary);
    transition:
      background-color var(--mot-fast) var(--ease-emphasis),
      border-color var(--mot-fast) var(--ease-emphasis),
      color var(--mot-fast) var(--ease-emphasis);
  }

  .mobile-action-secondary .mobile-action-icon {
    color: var(--brand-primary);
  }

  .mobile-action-secondary:hover,
  .mobile-action-secondary:focus-visible {
    background-color: var(--brand-primary-soft);
    border-color: var(--brand-primary-subtle);
    color: var(--brand-primary);
  }
</style>
