---
import { courseNavigation, mainNavigation } from '../../data/navigation';
---

<nav class="desktop-nav" aria-label="Primary navigation">
  <ul class="nav-list">
    {
      mainNavigation.map((item) => (
        <li class="nav-item">
          <a
            href={item.href}
            class:list={['nav-link', item.label === 'Courses' && 'has-panel']}
            aria-haspopup={item.label === 'Courses' ? 'true' : undefined}
          >
            <span>{item.label}</span>
            {item.label === 'Courses' && (
              <svg class="nav-chevron" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m4 6 4 4 4-4" />
              </svg>
            )}
          </a>

          {item.label === 'Courses' && (
            <div class="courses-panel" aria-label="Courses menu">
              <div class="panel-section">
                <p class="panel-heading">Our Programmes</p>
                <ul class="panel-list">
                  {courseNavigation.programmes.map((course) => (
                    <li>
                      <a href={course.href} class="panel-link">
                        <span>
                          <strong>{course.label}</strong>
                          <small>{course.description}</small>
                        </span>
                        <span class="panel-arrow" aria-hidden="true">
                          -&gt;
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="panel-section">
                <p class="panel-heading">Locations</p>
                <ul class="panel-list">
                  {courseNavigation.locations.map((location) => (
                    <li>
                      <a href={location.href} class="panel-link">
                        <span>
                          <strong>{location.label}</strong>
                          <small>{location.description}</small>
                        </span>
                        <span class="panel-arrow" aria-hidden="true">
                          -&gt;
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <a href={courseNavigation.allCourses.href} class="panel-all-link">
                {courseNavigation.allCourses.label}
                <span aria-hidden="true">-&gt;</span>
              </a>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .desktop-nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1.5rem, 1.9vw, 1.75rem);
    padding: 0;
    margin: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3125rem;
    min-height: 4.75rem;
    padding-inline: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 550;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #2e3138;
    transition:
      color var(--mot-fast) var(--ease-emphasis),
      opacity var(--mot-fast) var(--ease-emphasis);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 1.18rem;
    width: 1rem;
    height: 2px;
    background-color: var(--brand-primary);
    border-radius: var(--radius-pill);
    opacity: 0;
    transform: translateX(-50%) scaleX(0.72);
    transform-origin: center;
    transition:
      opacity var(--mot-fast) var(--ease-emphasis),
      transform var(--mot-fast) var(--ease-emphasis);
  }

  .nav-chevron {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.72;
    transition: transform var(--mot-fast) var(--ease-emphasis);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #15171c;
  }

  .nav-link:focus-visible {
    outline: 0;
    border-radius: var(--radius-sm);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-item:focus-within > .nav-link::after,
  .nav-item:hover > .nav-link::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
  }

  .nav-item:hover .nav-chevron,
  .nav-item:focus-within .nav-chevron {
    transform: translateY(1px);
  }

  .courses-panel {
    position: absolute;
    top: calc(100% - 0.5rem);
    left: 50%;
    width: min(25rem, calc(100vw - 2rem));
    padding: var(--sp-5) var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    border: var(--border-width-hairline) solid rgba(17, 24, 39, 0.1);
    border-radius: var(--radius-lg);
    background-color: rgba(255, 255, 255, 0.98);
    box-shadow: 0 1rem 2.75rem rgba(17, 19, 26, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.5rem);
    transition:
      opacity var(--mot-fast) var(--ease-emphasis),
      transform var(--mot-fast) var(--ease-emphasis),
      visibility var(--mot-fast) var(--ease-emphasis);
  }

  .nav-item:hover .courses-panel,
  .nav-item:focus-within .courses-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .panel-section + .panel-section {
    padding-top: var(--sp-4);
    border-top: var(--border-width-hairline) solid var(--border);
  }

  .panel-heading {
    margin: 0 0 var(--sp-3);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .panel-list {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .panel-link,
  .panel-all-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    letter-spacing: -0.01em;
    transition:
      background-color var(--mot-fast) var(--ease-emphasis),
      color var(--mot-fast) var(--ease-emphasis);
  }

  .panel-link {
    padding: var(--sp-2) 0;
    color: var(--text-primary);
  }

  .panel-link strong {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: var(--lh-meta);
  }

  .panel-link small {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.8125rem;
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  .panel-link:hover,
  .panel-link:focus-visible {
    background-color: var(--brand-primary-soft);
    color: var(--brand-primary);
  }

  .panel-link:hover small,
  .panel-link:focus-visible small {
    color: var(--text-secondary);
  }

  .panel-arrow {
    flex: 0 0 auto;
    color: var(--brand-primary);
    font-weight: 600;
  }

  .panel-all-link {
    margin-top: 0;
    border-top: var(--border-width-hairline) solid var(--border);
    padding: var(--sp-3) 0 0;
    justify-content: flex-end;
    color: var(--brand-primary);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .panel-all-link:hover,
  .panel-all-link:focus-visible {
    background-color: var(--brand-primary-soft);
  }
</style>
