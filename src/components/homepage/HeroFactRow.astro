---
interface Props {
  facts: string[];
}

const { facts } = Astro.props;
---

<ul class="hero-fact-row" aria-label="Program highlights">
  {
    facts.map((fact) => (
      <li>
        <span aria-hidden="true" />
        {fact}
      </li>
    ))
  }
</ul>

<style>
  .hero-fact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) 0;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .hero-fact-row li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text-secondary);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
  }

  .hero-fact-row li:not(:last-child)::after {
    content: '';
    width: 1px;
    height: 1rem;
    margin-inline: var(--sp-4);
    background-color: var(--border-strong);
  }

  .hero-fact-row span {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: var(--radius-pill);
    background-color: var(--brand-primary);
    flex: 0 0 auto;
  }

  @media (max-width: 480px) {
    .hero-fact-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
    }

    .hero-fact-row li::after {
      display: none;
    }
  }
</style>
