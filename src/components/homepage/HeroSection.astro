---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import HeroVisual from './HeroVisual.astro';
import { homepageHero } from '../../data/homepage/hero';
---

<Section class="homepage-hero" padding={false}>
  <Container wide={true}>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          <span class="eyebrow-highlight">{homepageHero.eyebrow.highlight}</span
          >
          <span>{homepageHero.eyebrow.rest}</span>
        </p>

        <h1>
          <span class="heading-line-main">{homepageHero.heading.main}</span>
          <span class="heading-line-accent">{homepageHero.heading.accent}</span>
        </h1>

        <p class="hero-value">{homepageHero.valueStatement}</p>
        <p class="hero-description">{homepageHero.description}</p>

        <div class="hero-actions" aria-label="Hero actions">
          <Button
            href={homepageHero.primaryCTA.href}
            size="lg"
            variant="primary"
            class="hero-primary-action"
          >
            {homepageHero.primaryCTA.label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </Button>
          <Button
            href={homepageHero.secondaryCTA.href}
            size="lg"
            variant="outline"
            class="hero-secondary-action"
          >
            {homepageHero.secondaryCTA.label}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path
                d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"
              ></path><path
                d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"
              ></path></svg
            >
          </Button>
        </div>

        <ul class="hero-proof-row" aria-label="Program highlights">
          {
            homepageHero.proofPoints.map((item) => (
              <li>
                <span aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <HeroVisual hero={homepageHero} />
    </div>

    <dl class="hero-trust-strip" aria-label="ASDM course proof points">
      {
        homepageHero.trustRow.map((item, index) => (
          <div class:list={['trust-item', index === 0 && 'trust-intro']}>
            {index === 0 ? (
              <dt>
                <span aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 3 19 6v5c0 4.7-2.9 8.6-7 10-4.1-1.4-7-5.3-7-10V6l7-3Z" />
                    <path d="m12 8 .9 1.9 2.1.3-1.5 1.5.4 2.1-1.9-1-1.9 1 .4-2.1L9 10.2l2.1-.3L12 8Z" />
                  </svg>
                </span>
                <span>{item.value}</span>
              </dt>
            ) : (
              <dt>{item.value}</dt>
            )}
            {index === 0 ? (
              <dd>
                Proven by <span>Results.</span>
              </dd>
            ) : (
              <dd>{item.label}</dd>
            )}
          </div>
        ))
      }
    </dl>
  </Container>
</Section>

<style>
  :global(.homepage-hero) {
    position: relative;
    overflow: clip;
    min-height: calc(100svh - var(--header-height));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), transparent 52%),
      radial-gradient(
        circle at 78% 28%,
        rgba(225, 38, 47, 0.07),
        transparent 28%
      ),
      var(--canvas);
    padding-block: clamp(3.25rem, 5vw, 5.75rem) 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(25rem, 1.08fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5.5rem);
    min-width: 0;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 44rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-5);
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 0.3vw + 0.68rem, 0.8125rem);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-wide);
    line-height: var(--lh-meta);
    color: var(--text-primary);
    text-transform: uppercase;
  }

  .eyebrow-mark {
    width: 2.5rem;
    height: 2px;
    background-color: var(--brand-primary);
    border-radius: var(--radius-pill);
  }

  .eyebrow-highlight {
    color: var(--brand-primary);
  }

  h1 {
    max-width: 43rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 5vw, 5.35rem);
    font-weight: var(--fw-bold);
    line-height: 0.96;
    letter-spacing: var(--ls-tight);
    color: var(--text-primary);
  }

  h1 span {
    display: block;
  }

  .heading-line-main {
    white-space: normal;
  }

  .heading-line-accent {
    margin-top: var(--sp-1);
    color: var(--brand-primary);
  }

  .hero-value {
    max-width: 39rem;
    margin: var(--sp-6) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.45rem);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-heading);
    color: var(--text-primary);
  }

  .hero-description {
    max-width: 39rem;
    margin: var(--sp-4) 0 0;
    font-size: clamp(1rem, 0.26vw + 0.94rem, 1.0625rem);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  :global(.hero-primary-action),
  :global(.hero-secondary-action) {
    min-height: 3.25rem;
    border-radius: var(--radius-md);
    gap: var(--sp-2);
    padding-inline: var(--sp-6);
  }

  :global(.hero-primary-action svg) {
    transition: transform var(--mot-fast) var(--ease-emphasis);
  }

  :global(.hero-primary-action:hover svg) {
    transform: translateX(0.2rem);
  }

  :global(.hero-secondary-action) {
    background-color: rgba(255, 255, 255, 0.8) !important;
    border-color: var(--border-strong) !important;
    color: var(--text-primary) !important;
  }

  :global(.hero-secondary-action svg) {
    color: var(--brand-primary);
  }

  :global(.hero-secondary-action:hover) {
    background-color: var(--brand-primary-soft) !important;
    border-color: var(--brand-primary-subtle) !important;
    color: var(--brand-primary) !important;
  }

  .hero-proof-row {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    align-items: center;
    gap: var(--sp-3) var(--sp-6);
    padding: 0;
    margin: var(--sp-7) 0 0;
    list-style: none;
  }

  .hero-proof-row li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
    color: var(--text-primary);
  }

  .hero-proof-row li:not(:last-child)::after {
    display: none;
  }

  .hero-proof-row li span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background-color: var(--brand-primary);
    flex: 0 0 auto;
  }

  .hero-trust-strip {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1.28fr repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 0;
    margin: clamp(1.25rem, 2vw, 2.25rem) auto 0;
    padding: var(--sp-5) clamp(var(--sp-5), 3.4vw, var(--sp-10));
    background: rgba(255, 255, 255, 0.94);
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.92);
    border-bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    box-shadow: 0 -0.4rem 2rem rgba(17, 19, 26, 0.05);
  }

  .trust-item {
    min-height: 3.9rem;
    display: grid;
    align-content: center;
    padding-inline: clamp(var(--sp-4), 2.2vw, var(--sp-7));
    border-left: var(--border-width-hairline) solid var(--border-strong);
  }

  .trust-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trust-item dt {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.8vw + 1rem, 1.5rem);
    font-weight: var(--fw-bold);
    line-height: var(--lh-meta);
    color: var(--text-primary);
  }

  .trust-intro dt {
    font-size: var(--fs-body);
    line-height: var(--lh-heading);
  }

  .trust-intro dt span:first-child {
    width: 3.25rem;
    height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: var(--border-width-hairline) solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--brand-primary);
    flex: 0 0 auto;
  }

  .trust-intro svg {
    width: 1.9rem;
    height: 1.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .trust-item dd {
    margin: var(--sp-1) 0 0;
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  .trust-intro dd {
    padding-left: calc(3.25rem + var(--sp-4));
  }

  .trust-intro dd span {
    color: var(--brand-primary);
    font-weight: var(--fw-bold);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-12);
      min-width: 0;
    }

    .hero-copy {
      max-width: 46rem;
    }

    .heading-line-main {
      white-space: normal;
    }

    .hero-trust-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .trust-item:nth-child(odd) {
      border-left: 0;
    }
  }

  @media (max-width: 640px) {
    :global(.homepage-hero) {
      padding-block: var(--sp-10) 0;
    }

    .hero-copy {
      width: 100%;
      min-width: 0;
    }

    h1 {
      font-size: clamp(2.65rem, 11vw, 3.7rem);
      line-height: 1.05;
      overflow-wrap: normal;
    }

    .heading-line-main {
      white-space: normal;
      overflow-wrap: break-word;
    }

    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    :global(.hero-primary-action),
    :global(.hero-secondary-action) {
      width: 100%;
    }

    .hero-proof-row {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--sp-3);
    }

    .hero-proof-row li::after {
      display: none;
    }

    .hero-trust-strip {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
      padding: var(--sp-5);
      margin-top: var(--sp-8);
    }

    .trust-item,
    .trust-item:first-child,
    .trust-item:nth-child(odd) {
      padding: 0 0 0 var(--sp-4);
      border-left: var(--border-width-strong) solid var(--brand-primary);
    }

    .trust-intro dd {
      padding-left: 0;
    }
  }
</style>
