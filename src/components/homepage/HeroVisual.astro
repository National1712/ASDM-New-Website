---
import type { HomepageHeroContent } from '../../data/homepage/hero';

interface Props {
  hero: HomepageHeroContent;
}

const { hero } = Astro.props;
---

<aside class="hero-visual" aria-label="ASDM practical learning visual">
  <div class="visual-container">
    <div class="visual-dots visual-dots-left" aria-hidden="true"></div>
    <div class="visual-dots visual-dots-right" aria-hidden="true"></div>
    <div class="visual-line visual-line-one" aria-hidden="true"></div>
    <div class="visual-line visual-line-two" aria-hidden="true"></div>

    <div class="brand-a-device" aria-hidden="true">
      <span class="a-stem a-stem-left"></span>
      <span class="a-stem a-stem-right"></span>
      <span class="a-cross"></span>
      <span class="a-red-leg"></span>
    </div>

    <div class="student-frame">
      <img
        src={hero.visualAsset}
        alt={hero.visualAlt}
        class="student-image"
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    {
      hero.floatingCards.map((card, index) => (
        <div class={`proof-card proof-card-${index + 1}`}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {card.icon === 'students' && (
              <>
                <path d="M16 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2" />
                <circle cx="9.5" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.9" />
                <path d="M16 3.1a4 4 0 0 1 0 7.8" />
              </>
            )}
            {card.icon === 'partners' && (
              <>
                <path d="M8 11 5.6 8.6a2.1 2.1 0 0 1 0-3L7 4.2a2.1 2.1 0 0 1 3 0l1 1" />
                <path d="m16 13 2.4 2.4a2.1 2.1 0 0 1 0 3L17 19.8a2.1 2.1 0 0 1-3 0l-1-1" />
                <path d="m8 13 8-8" />
                <path d="m7 17 10-10" />
              </>
            )}
            {card.icon === 'package' && (
              <>
                <path d="m3 17 6-6 4 4 8-8" />
                <path d="M14 7h7v7" />
              </>
            )}
            {card.icon === 'batches' && (
              <>
                <path d="m22 10-10-5-10 5 10 5 10-5Z" />
                <path d="M6 12v5c3.6 2 8.4 2 12 0v-5" />
              </>
            )}
            {card.icon === 'calendar' && (
              <>
                <path d="M8 2v4" />
                <path d="M16 2v4" />
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M3 10h18" />
              </>
            )}
          </svg>
          <strong>{card.metric}</strong>
          <span>{card.detail}</span>
        </div>
      ))
    }

    <div class="tools-panel" aria-label="Digital marketing tools covered">
      {
        hero.tools.map((tool) => (
          <div class="tool-item">
            {tool.icon === 'google-ads' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285f4" d="M14.9 4.2 22 16.5l-3.7 2.1L11.2 6.3z" />
                <path fill="#fbbc04" d="M9.1 4.2 2 16.5l3.7 2.1 7.1-12.3z" />
                <circle cx="5.8" cy="16.4" r="3.2" fill="#34a853" />
              </svg>
            )}
            {tool.icon === 'meta-ads' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#0064e0"
                aria-hidden="true"
              >
                <path
                  d="M4 14c1.7-4.8 3.4-7 5.4-7 1.5 0 2.7 1.1 4.2 3.2C15.1 8.1 16.4 7 18 7c2.3 0 3.5 2 3.5 5s-1.3 5-3.5 5c-1.7 0-3-1.2-4.4-3.2C12.1 15.8 10.8 17 9.2 17 7 17 5.7 15.2 4 14Z"
                  stroke-width="2"
                />
              </svg>
            )}
            {tool.icon === 'seo' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#e1262f"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" stroke-width="2" />
                <path d="m16 16 5 5" stroke-width="2" stroke-linecap="round" />
                <path d="M8 11h6" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            )}
            {tool.icon === 'analytics' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="12" width="4" height="8" rx="2" fill="#f9ab00" />
                <rect
                  x="10"
                  y="7"
                  width="4"
                  height="13"
                  rx="2"
                  fill="#e37400"
                />
                <rect
                  x="16"
                  y="3"
                  width="4"
                  height="17"
                  rx="2"
                  fill="#f9ab00"
                />
              </svg>
            )}
            {tool.icon === 'chatgpt' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#10a37f"
                aria-hidden="true"
              >
                <path
                  d="M8.5 4.8A4.3 4.3 0 0 1 16.2 6a4.3 4.3 0 0 1 3 7.2 4.3 4.3 0 0 1-5.6 6.2A4.3 4.3 0 0 1 6 18a4.3 4.3 0 0 1-1.2-7.7A4.3 4.3 0 0 1 8.5 4.8Z"
                  stroke-width="1.8"
                />
                <path d="M8 12h8M12 8v8" stroke-width="1.8" />
              </svg>
            )}
            <span>{tool.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>

<style>
  .hero-visual {
    position: relative;
    width: min(116%, 50rem);
    max-width: none;
    margin-left: clamp(-6.5rem, -5vw, -3rem);
    margin-right: 0;
  }

  .visual-container {
    position: relative;
    min-height: clamp(34rem, 43vw, 41rem);
    isolation: isolate;
  }

  .visual-dots {
    position: absolute;
    width: 5.5rem;
    height: 5.5rem;
    background-image: radial-gradient(
      rgba(17, 19, 26, 0.18) 1px,
      transparent 1px
    );
    background-size: 0.62rem 0.62rem;
    opacity: 0.55;
    z-index: 0;
  }

  .visual-dots-left {
    left: 16%;
    top: 12%;
  }

  .visual-dots-right {
    right: -2%;
    top: 30%;
  }

  .visual-line {
    position: absolute;
    width: 1px;
    height: 9rem;
    background-color: rgba(225, 38, 47, 0.5);
    transform: rotate(18deg);
    z-index: 1;
  }

  .visual-line-one {
    top: 10%;
    right: 28%;
  }

  .visual-line-two {
    top: 14%;
    right: 23%;
    opacity: 0.5;
  }

  .brand-a-device {
    position: absolute;
    inset: 3% 1% 8% 8%;
    z-index: 1;
  }

  .a-stem,
  .a-cross,
  .a-red-leg {
    position: absolute;
    display: block;
    border-radius: var(--radius-md);
    transform-origin: center;
  }

  .a-stem {
    bottom: 2%;
    width: 30%;
    height: 92%;
    background: linear-gradient(180deg, #ffffff, var(--surface-soft));
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.92);
    box-shadow: var(--shadow-soft);
  }

  .a-stem-left {
    left: 20%;
    transform: skewX(-23deg);
  }

  .a-stem-right {
    right: 9%;
    transform: skewX(23deg);
  }

  .a-cross {
    left: 31%;
    right: 11%;
    top: 41%;
    height: 18%;
    background-color: #e1262f;
    transform: skewX(-18deg);
    box-shadow: 0 1.2rem 2.5rem rgba(225, 38, 47, 0.18);
  }

  .a-red-leg {
    right: 4%;
    bottom: 6%;
    width: 30%;
    height: 39%;
    background-color: rgba(225, 38, 47, 0.94);
    transform: skewX(19deg);
  }

  .student-frame {
    position: absolute;
    inset: 4% 9% 0 -2%;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    border-radius: 0 0 var(--radius-feature) var(--radius-feature);
  }

  .student-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0 58%,
      rgba(255, 255, 255, 0.75)
    );
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 1;
  }

  .student-frame::after {
    content: '';
    position: absolute;
    inset: auto 6% 0;
    height: 19%;
    background: linear-gradient(180deg, transparent, rgba(247, 248, 251, 0.96));
    pointer-events: none;
    z-index: 2;
  }

  .student-image {
    position: relative;
    z-index: 0;
    width: min(137%, 52rem);
    height: auto;
    object-fit: contain;
    object-position: center bottom;
    transform: translateX(-9%);
    mix-blend-mode: multiply;
    filter: contrast(1.05) drop-shadow(0 1.6rem 2.4rem rgba(17, 19, 26, 0.14));
  }

  .proof-card {
    position: absolute;
    z-index: 5;
    width: clamp(9.1rem, 11.2vw, 10.8rem);
    min-height: 7.9rem;
    padding: var(--sp-4);
    background-color: rgba(255, 255, 255, 0.95);
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.92);
    border-radius: var(--radius-md);
    box-shadow: 0 1.15rem 2.7rem rgba(17, 19, 26, 0.1);
    display: grid;
    align-content: center;
    gap: var(--sp-2);
  }

  .proof-card svg {
    width: 1.45rem;
    height: 1.45rem;
    color: var(--brand-primary);
  }

  .proof-card strong {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 0.72vw + 1rem, 1.55rem);
    font-weight: var(--fw-bold);
    line-height: 1.05;
    color: var(--text-primary);
  }

  .proof-card span {
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  .proof-card-1 {
    right: 5%;
    top: 12%;
  }

  .proof-card-2 {
    left: 0;
    top: 32%;
  }

  .proof-card-3 {
    right: 2%;
    top: 36%;
  }

  .proof-card-4 {
    left: -1%;
    top: 56%;
  }

  .proof-card-5 {
    right: 7%;
    bottom: 10%;
  }

  .tools-panel {
    position: absolute;
    z-index: 6;
    left: 3%;
    right: 5%;
    bottom: 0.5%;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    padding: var(--sp-3);
    background-color: rgba(255, 255, 255, 0.92);
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.92);
    border-radius: var(--radius-lg);
    box-shadow: 0 1rem 2.4rem rgba(17, 19, 26, 0.09);
    backdrop-filter: blur(10px);
  }

  .tool-item {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: var(--sp-2);
    text-align: center;
    padding-inline: var(--sp-1);
    border-left: var(--border-width-hairline) solid var(--border);
  }

  .tool-item:first-child {
    border-left: 0;
  }

  .tool-item svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .tool-item span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.64rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
    color: var(--text-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .student-frame,
    .proof-card,
    .tools-panel {
      animation: visual-rise 560ms var(--ease-emphasis) both;
    }

    .proof-card-1 {
      animation-delay: 60ms;
    }

    .proof-card-3 {
      animation-delay: 110ms;
    }

    .proof-card-5 {
      animation-delay: 150ms;
    }
  }

  @keyframes visual-rise {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .hero-visual {
      width: 100%;
      max-width: 42rem;
      margin-inline: auto;
    }

    .visual-container {
      min-height: clamp(32rem, 66vw, 39rem);
    }
  }

  @media (max-width: 640px) {
    .hero-visual {
      max-width: 29rem;
      min-width: 0;
    }

    .visual-container {
      min-height: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-3);
      padding-top: 96%;
      min-width: 0;
    }

    .brand-a-device,
    .student-frame {
      inset: 0 0 30%;
    }

    .student-frame {
      border-radius: var(--radius-feature);
    }

    .student-image {
      width: 92%;
    }

    .visual-dots,
    .visual-line {
      display: none;
    }

    .proof-card,
    .proof-card-1,
    .proof-card-2,
    .proof-card-3,
    .proof-card-4,
    .proof-card-5 {
      position: relative;
      inset: auto;
      width: auto;
      min-height: 7rem;
    }

    .proof-card-3 {
      display: none;
    }

    .tools-panel {
      position: relative;
      inset: auto;
      grid-column: 1 / -1;
      grid-template-columns: repeat(5, minmax(4.25rem, 1fr));
      overflow-x: auto;
      margin-top: var(--sp-2);
      padding: var(--sp-3);
      min-width: 0;
    }
  }
</style>
