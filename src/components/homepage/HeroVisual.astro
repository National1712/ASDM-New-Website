---
import type { HomepageHeroContent } from '../../data/homepage/hero';

interface Props {
  hero: HomepageHeroContent;
}

const { hero } = Astro.props;
const [batchesCard, partnersCard, outcomesCard] = hero.floatingCards;
---

<aside class="hero-visual" aria-label="ASDM practical learning visual">
  <div class="visual-container">
    <div class="brand-a-device" aria-hidden="true">
      <span class="a-stem stem-left"></span>
      <span class="a-stem stem-right"></span>
      <span class="a-cross"></span>
      <span class="a-red-plane"></span>
    </div>

    <div class="student-frame">
      <img
        src={hero.visualAsset}
        alt={hero.visualAlt}
        class="student-image"
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="proof-card proof-card-one">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M8 2v4"></path>
        <path d="M16 2v4"></path>
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <path d="M3 10h18"></path>
      </svg>
      <strong>{batchesCard.label}</strong>
      <span>{batchesCard.detail}</span>
    </div>

    <div class="proof-card proof-card-two">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="7" width="18" height="13" rx="2"></rect>
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
        <path d="M3 13h18"></path>
      </svg>
      <strong>{partnersCard.label}</strong>
      <span>{partnersCard.detail}</span>
    </div>

    <div class="proof-card proof-card-three">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m3 17 6-6 4 4 8-8"></path>
        <path d="M14 7h7v7"></path>
      </svg>
      <strong>{outcomesCard.label}</strong>
      <span>{outcomesCard.detail}</span>
    </div>

    <div class="tools-panel" aria-label="Digital marketing tools covered">
      {
        hero.tools.map((tool) => (
          <div class="tool-item">
            {tool.icon === 'google-ads' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285f4" d="M14.9 4.2 22 16.5l-3.7 2.1L11.2 6.3z" />
                <path fill="#fbbc04" d="M9.1 4.2 2 16.5l3.7 2.1 7.1-12.3z" />
                <circle cx="5.8" cy="16.4" r="3.2" fill="#34a853" />
              </svg>
            )}
            {tool.icon === 'meta-ads' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#0064e0"
                aria-hidden="true"
              >
                <path
                  d="M4 14c1.7-4.8 3.4-7 5.4-7 1.5 0 2.7 1.1 4.2 3.2C15.1 8.1 16.4 7 18 7c2.3 0 3.5 2 3.5 5s-1.3 5-3.5 5c-1.7 0-3-1.2-4.4-3.2C12.1 15.8 10.8 17 9.2 17 7 17 5.7 15.2 4 14Z"
                  stroke-width="2"
                />
              </svg>
            )}
            {tool.icon === 'chatgpt' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#10a37f"
                aria-hidden="true"
              >
                <path
                  d="M8.5 4.8A4.3 4.3 0 0 1 16.2 6a4.3 4.3 0 0 1 3 7.2 4.3 4.3 0 0 1-5.6 6.2A4.3 4.3 0 0 1 6 18a4.3 4.3 0 0 1-1.2-7.7A4.3 4.3 0 0 1 8.5 4.8Z"
                  stroke-width="1.8"
                />
                <path d="M8 12h8M12 8v8" stroke-width="1.8" />
              </svg>
            )}
            {tool.icon === 'ga4' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="12" width="4" height="8" rx="2" fill="#f9ab00" />
                <rect
                  x="10"
                  y="7"
                  width="4"
                  height="13"
                  rx="2"
                  fill="#e37400"
                />
                <rect
                  x="16"
                  y="3"
                  width="4"
                  height="17"
                  rx="2"
                  fill="#f9ab00"
                />
              </svg>
            )}
            {tool.icon === 'seo' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="#e1262f"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" stroke-width="2" />
                <path d="m16 16 5 5" stroke-width="2" stroke-linecap="round" />
                <path d="M7.5 11h7" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            )}
            {tool.icon === 'canva' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" fill="#65429b" />
                <path
                  d="M15.5 8.5c-1-.9-2.1-1.3-3.4-1.3-2.8 0-5 2.1-5 4.8s2.1 4.8 5 4.8c1.5 0 2.7-.5 3.7-1.5"
                  fill="none"
                  stroke="#fff"
                  stroke-width="2"
                  stroke-linecap="round"
                />
              </svg>
            )}
            <span>{tool.name}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>

<style>
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
  }

  .visual-container {
    position: relative;
    min-height: clamp(35rem, 49vw, 45rem);
    isolation: isolate;
  }

  .brand-a-device {
    position: absolute;
    inset: 5% 5% 10% 4%;
    z-index: 0;
  }

  .a-stem,
  .a-cross,
  .a-red-plane {
    position: absolute;
    display: block;
    border-radius: var(--radius-lg);
    transform-origin: center;
  }

  .a-stem {
    bottom: 2%;
    width: 30%;
    height: 88%;
    background: linear-gradient(180deg, #ffffff, var(--surface-soft));
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.9);
    box-shadow: var(--shadow-soft);
  }

  .stem-left {
    left: 18%;
    transform: skewX(-18deg);
  }

  .stem-right {
    right: 10%;
    transform: skewX(18deg);
  }

  .a-cross {
    left: 26%;
    right: 20%;
    top: 42%;
    height: 22%;
    background-color: var(--brand-primary);
    transform: skewX(-16deg);
    box-shadow: 0 1.25rem 3rem rgba(225, 38, 47, 0.18);
  }

  .a-red-plane {
    right: 7%;
    bottom: 6%;
    width: 30%;
    height: 38%;
    background-color: rgba(225, 38, 47, 0.92);
    transform: skewX(18deg);
  }

  .student-frame {
    position: absolute;
    inset: 3% 10% 0 10%;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    border-radius: 0 0 var(--radius-feature) var(--radius-feature);
  }

  .student-frame::after {
    content: '';
    position: absolute;
    inset: auto 8% 0;
    height: 16%;
    background: linear-gradient(180deg, transparent, rgba(247, 248, 251, 0.96));
    pointer-events: none;
  }

  .student-image {
    width: min(92%, 35rem);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1.6rem 2.4rem rgba(17, 19, 26, 0.14));
  }

  .proof-card {
    position: absolute;
    z-index: 4;
    width: clamp(9.25rem, 13vw, 11rem);
    padding: var(--sp-4);
    background-color: rgba(255, 255, 255, 0.94);
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.9);
    border-radius: var(--radius-lg);
    box-shadow: 0 1.25rem 3rem rgba(17, 19, 26, 0.1);
    display: grid;
    gap: var(--sp-2);
  }

  .proof-card svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--brand-primary);
  }

  .proof-card strong {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.65vw + 1rem, 1.45rem);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    color: var(--text-primary);
  }

  .proof-card span {
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  .proof-card-one {
    left: 1%;
    top: 29%;
  }

  .proof-card-two {
    right: 0;
    top: 11%;
  }

  .proof-card-three {
    right: -1%;
    top: 48%;
  }

  .tools-panel {
    position: absolute;
    z-index: 5;
    left: 10%;
    right: 10%;
    bottom: 6%;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background-color: rgba(255, 255, 255, 0.91);
    border: var(--border-width-hairline) solid rgba(223, 227, 234, 0.9);
    border-radius: var(--radius-lg);
    box-shadow: 0 1rem 2.4rem rgba(17, 19, 26, 0.1);
    backdrop-filter: blur(12px);
  }

  .tool-item {
    min-width: 0;
    display: grid;
    justify-items: center;
    gap: var(--sp-1);
    text-align: center;
  }

  .tool-item svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .tool-item span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: var(--fw-semibold);
    line-height: var(--lh-meta);
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .student-frame,
    .proof-card,
    .tools-panel {
      animation: visual-rise 560ms var(--ease-emphasis) both;
    }

    .proof-card-two {
      animation-delay: 80ms;
    }

    .proof-card-three {
      animation-delay: 140ms;
    }
  }

  @keyframes visual-rise {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .visual-container {
      min-height: clamp(31rem, 68vw, 39rem);
    }
  }

  @media (max-width: 640px) {
    .hero-visual {
      max-width: 29rem;
    }

    .visual-container {
      min-height: auto;
      display: grid;
      gap: var(--sp-4);
      padding-top: 92%;
    }

    .brand-a-device,
    .student-frame {
      inset: 0 0 23%;
    }

    .student-frame {
      border-radius: var(--radius-feature);
    }

    .student-image {
      width: 88%;
    }

    .proof-card,
    .proof-card-one,
    .proof-card-two,
    .proof-card-three {
      position: relative;
      inset: auto;
      width: auto;
      min-height: 7rem;
    }

    .proof-card-one {
      margin-top: var(--sp-2);
    }

    .tools-panel {
      position: relative;
      inset: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: var(--sp-2);
    }
  }
</style>
